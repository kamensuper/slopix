{
	"version": 1,
	"inference": {
		"run": {
			"detectorVersion": 4,
			"framework": "vite",
			"workspacePath": "game"
		}
	},
	"ports": {
		"preview": 5173,
		"additional": {}
	},
	"services": [],
	"scripts": {
		"setup": {
			"enabled": true,
			"command": "cd game && npm ci"
		},
		"run": {
			"enabled": true,
			"command": "cd game && npx vite build && npx vite preview --port 5173 --strictPort"
		},
		"archive": {
			"enabled": true,
			"command": null
		}
	},
	"mcpServers": []
}
